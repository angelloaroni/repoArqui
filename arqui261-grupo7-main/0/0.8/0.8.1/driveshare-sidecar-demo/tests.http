### ====================================
### 1. Crear usuario
### ====================================

POST http://localhost:3000/users
Content-Type: application/json

{
  "email": "juan@gmail.com",
  "name": "Juan",
  "lastname": "Perez",
  "role": "arrendatario"
}


### ====================================
### 2. Obtener usuario
### ====================================

GET http://localhost:3000/users/1


### ====================================
### 3. Cambio exitoso
### arrendatario -> arrendador
### ====================================

PATCH http://localhost:3000/users/1/role
Content-Type: application/json

{
  "role": "arrendador"
}


### ====================================
### 4. Cambio inválido
### ====================================

PATCH http://localhost:3000/users/1/role
Content-Type: application/json

{
  "role": "superadmin"
}


### ====================================
### 5. Ver auditorías
### ====================================

GET http://localhost:4000/audit