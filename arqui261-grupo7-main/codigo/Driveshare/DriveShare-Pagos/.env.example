# ---- Servidor ----
PORT=3004

# ---- PostgreSQL (Decisión 3, sección 4.4: modelo relacional) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=driveshare
DB_PASSWORD=driveshare
DB_NAME=driveshare_pagos

# ---- Redis (cola BullMQ, Decisión 4) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- RabbitMQ (eventos Pub/Sub, Decisión 2) ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=pagos.eventos

# ---- Stripe (proveedor de pagos, patrón Adapter) ----
# La llave SECRETA (sk_test_...) va SOLO aquí, nunca se comparte ni se sube a git.
STRIPE_SECRET_KEY=sk_test_pon_aqui_tu_llave_secreta
STRIPE_MOCK=true                  # true = simula cobros sin llave real (para demo)
# La llave PUBLICABLE (pk_test_...) NO va aquí: va en el frontend (Stripe.js).

# ---- Reglas de negocio ----
COMISION_PLATAFORMA=0.10          # 10% de comisión (RF36)
PLAZO_REEMBOLSO_HORAS=48          # ventana de cancelación con reembolso (RF33)

# ---- Servicios internos (validaciones síncronas Cliente-Servidor) ----
USUARIOS_SERVICE_URL=http://localhost:3001/api
RESERVAS_SERVICE_URL=http://localhost:3003/api
